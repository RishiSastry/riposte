# ── Rust (compiler/) ──
target/
**/*.rs.bk
# Cargo.lock IS committed: the workspace ships a binary (riposte-c), so pin deps.

# ── compiler-generated outputs (checked-in policies are hand-written examples) ──
*.diag.json

# ── Python (runtime/, mcp/, evalkit/, evals/) ──
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Eval artifacts ──
*.sqlite
*.parquet
evals/runs/           # per-run battle logs, traces, results
**/*.jsonl            # per-battle trajectory traces (regenerable)

# ── Showdown server (cloned & pinned at M0) ──
pokemon-showdown/

# ── OS / editor ──
.DS_Store
.idea/
.vscode/
*.swp
